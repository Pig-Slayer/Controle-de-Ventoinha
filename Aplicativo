class VentoinhaApp:
    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title("Controle de Ventoinha PID - ESP32")
        self.root.geometry("1360x820")
        self.root.minsize(1120, 700)
        self.root.configure(bg=BG_MAIN)

        # Comunicacao Serial
        self.ser: serial.Serial | None = None
        self.serial_lock = threading.Lock()
        self.stop_event = threading.Event()
        self.reader_thread: threading.Thread | None = None
        self.msg_queue: queue.Queue = queue.Queue()

        # Estado atual dos parametros (espelho do firmware ESP32)
        self.estado = {
            "modo":    "DESCONECTADO",
            "sp":      5000.0,
            "pv":      0.0,
            "calc":    0.0,
            "pwm":     0.0,
            "hz":      0.0,
            "kp":      0.0193,
            "ki":      0.0097,
            "kd":      0.0,
            "sp_max":  5000.0,
            "sp_min":  1000.0,
            "pwm_min": 30.0,
            "pwm_max": 100.0,
            "tempo":   5.0,
            "ppr":     2.0,
        }

        # Parametros do Modelo Teorico Calculado: G(s) = K / (tau*s + 1)
        self.modelo_k = 50.0
        self.modelo_tau = 1.0
        self.y_calc = 0.0
        self.t_inicio: float | None = None
        self.t_ultimo: float | None = None

        # Buffers de dados para grafico e exportacao CSV
        self.max_pontos_grafico = 3000
        self.t_hist    = deque(maxlen=self.max_pontos_grafico)
        self.sp_hist   = deque(maxlen=self.max_pontos_grafico)
        self.pv_hist   = deque(maxlen=self.max_pontos_grafico)
        self.calc_hist = deque(maxlen=self.max_pontos_grafico)
        self.pwm_hist  = deque(maxlen=self.max_pontos_grafico)
        self.sessao_csv: list[tuple] = []

        # Variaveis de exibicao no grafico
        self.var_show_real = tk.BooleanVar(value=True)
        self.var_show_calc = tk.BooleanVar(value=True)
        self.var_show_sp   = tk.BooleanVar(value=True)
        self.var_show_pwm  = tk.BooleanVar(value=True)
        self.var_janela_s  = tk.StringVar(value="60")

        self._configurar_estilo()
        self._construir_interface()
        self._atualizar_portas()
        self._atualizar_cards_status()

        # Loop de atualizacao da UI (20 Hz)
        self.root.after(50, self._processar_fila)
        self.root.protocol("WM_DELETE_WINDOW", self._ao_fechar)

    # -------------------------------------------------------------------------
    # ESTILO E CONSTRUCAO DA INTERFACE
    # -------------------------------------------------------------------------
    def _configurar_estilo(self):
        style = ttk.Style()
        style.theme_use("clam")

        style.configure("TFrame", background=BG_MAIN)
        style.configure("Panel.TFrame", background=BG_PANEL)
        style.configure("Card.TFrame", background=BG_CARD)

        style.configure("TLabel", background=BG_PANEL, foreground=FG_TEXT, font=("Segoe UI", 10))
        style.configure("Title.TLabel", background=BG_PANEL, foreground=FG_TEXT, font=("Segoe UI", 11, "bold"))
        style.configure("Muted.TLabel", background=BG_PANEL, foreground=FG_MUTED, font=("Segoe UI", 9))

        style.configure(
            "TCombobox",
            fieldbackground=BG_INPUT,
            background=BG_CARD,
            foreground=FG_TEXT,
            arrowcolor=FG_TEXT,
        )
        style.map(
            "TCombobox",
            fieldbackground=[("readonly", BG_INPUT)],
            foreground=[("readonly", FG_TEXT)],
        )

    def _construir_interface(self):
        # 1) Barra superior: Conexao Serial + Acoes
        barra_top = tk.Frame(self.root, bg=BG_PANEL, padx=12, pady=8)
        barra_top.pack(fill=tk.X, padx=10, pady=(10, 6))

        tk.Label(
            barra_top, text="Porta Serial:", bg=BG_PANEL, fg=FG_TEXT, font=("Segoe UI", 10, "bold")
        ).pack(side=tk.LEFT, padx=(0, 6))

        self.combo_porta = ttk.Combobox(barra_top, width=26, state="readonly")
        self.combo_porta.pack(side=tk.LEFT, padx=(0, 6))

        self._criar_botao(barra_top, "Atualizar", self._atualizar_portas, bg=BG_CARD).pack(
            side=tk.LEFT, padx=(0, 8)
        )

        self.btn_conectar = self._criar_botao(
            barra_top, "Conectar", self._alternar_conexao, bg=ACCENT, width=12
        )
        self.btn_conectar.pack(side=tk.LEFT, padx=(0, 8))

        self._criar_botao(
            barra_top, "Sincronizar (STATUS)", lambda: self._enviar_comando("STATUS"), bg=BG_CARD
        ).pack(side=tk.LEFT, padx=(0, 8))

        self._criar_botao(
            barra_top, "Limpar Grafico", self._limpar_dados, bg=BG_CARD
        ).pack(side=tk.LEFT, padx=(0, 8))

        self._criar_botao(
            barra_top, "Exportar CSV", self._exportar_csv, bg=BG_CARD
        ).pack(side=tk.LEFT, padx=(0, 8))

        self.lbl_conexao = tk.Label(
            barra_top, text="● DESCONECTADO", bg=BG_PANEL, fg=COLOR_ERR, font=("Segoe UI", 10, "bold")
        )
        self.lbl_conexao.pack(side=tk.RIGHT, padx=6)

        # 2) Painel permanente de parametros e leituras em tempo real
        self._construir_barra_telemetria()

        # 3) Corpo principal (Esquerda: Grafico + Modo Auto | Direita: Entradas numericas)
        corpo = tk.Frame(self.root, bg=BG_MAIN)
        corpo.pack(fill=tk.BOTH, expand=True, padx=10, pady=(0, 10))
        corpo.columnconfigure(0, weight=7)
        corpo.columnconfigure(1, weight=3, minsize=360)
        corpo.rowconfigure(0, weight=1)

        # --- COLUNA ESQUERDA ---
        col_esq = tk.Frame(corpo, bg=BG_MAIN)
        col_esq.grid(row=0, column=0, sticky="nsew", padx=(0, 8))
        col_esq.rowconfigure(0, weight=1)
        col_esq.columnconfigure(0, weight=1)

        self._construir_painel_grafico(col_esq)
        self._construir_painel_modo_auto(col_esq)

        # --- COLUNA DIREITA ---
        col_dir = tk.Frame(corpo, bg=BG_PANEL, padx=12, pady=10)
        col_dir.grid(row=0, column=1, sticky="nsew")
        self._construir_painel_controles(col_dir)

    def _construir_barra_telemetria(self):
        frame_tel = tk.Frame(self.root, bg=BG_PANEL, padx=10, pady=8)
        frame_tel.pack(fill=tk.X, padx=10, pady=(0, 8))

        self.cards = {}
        definicoes = [
            ("modo",    "MODO",            FG_TEXT),
            ("pv",      "REAL (PV)",       COLOR_REAL),
            ("calc",    "CALCULADO",       COLOR_CALC),
            ("sp",      "SETPOINT (SP)",   COLOR_SP),
            ("erro",    "ERRO (SP-PV)",    FG_TEXT),
            ("pwm",     "PWM / MV",        COLOR_PWM),
            ("pwm_lim", "PWM MIN / MAX",   COLOR_PWM),
            ("hz",      "HALL (Hz)",       FG_MUTED),
            ("kp",      "Kp",              FG_TEXT),
            ("ki",      "Ki",              FG_TEXT),
            ("kd",      "Kd",              FG_TEXT),
            ("lim",     "SP MIN / MAX",    FG_MUTED),
            ("extra",   "TEMPO | PPR",     FG_MUTED),
        ]

        for idx, (chave, titulo, cor) in enumerate(definicoes):
            frame_tel.columnconfigure(idx, weight=1)
            card = tk.Frame(
                frame_tel, bg=BG_CARD, padx=5, pady=5,
                highlightbackground="#334155", highlightthickness=1
            )
            card.grid(row=0, column=idx, sticky="nsew", padx=2)

            tk.Label(card, text=titulo, bg=BG_CARD, fg=FG_MUTED, font=("Segoe UI", 8, "bold")).pack(anchor="w")
            lbl_val = tk.Label(card, text="--", bg=BG_CARD, fg=cor, font=("Consolas", 10, "bold"))
            lbl_val.pack(anchor="w")
            self.cards[chave] = lbl_val

    def _construir_painel_grafico(self, parent):
        frame_graf = tk.Frame(parent, bg=BG_PANEL, padx=8, pady=8)
        frame_graf.grid(row=0, column=0, sticky="nsew", pady=(0, 8))
        frame_graf.rowconfigure(1, weight=1)
        frame_graf.columnconfigure(0, weight=1)

        topo_graf = tk.Frame(frame_graf, bg=BG_PANEL)
        topo_graf.grid(row=0, column=0, sticky="ew", pady=(0, 6))

        tk.Label(
            topo_graf, text="Grafico: Calculado e Real (Tempo Real)",
            bg=BG_PANEL, fg=FG_TEXT, font=("Segoe UI", 11, "bold")
        ).pack(side=tk.LEFT)

        controles_curva = tk.Frame(topo_graf, bg=BG_PANEL)
        controles_curva.pack(side=tk.RIGHT)

        tk.Label(controles_curva, text="Janela (s):", bg=BG_PANEL, fg=FG_MUTED, font=("Segoe UI", 9)).pack(
            side=tk.LEFT, padx=(0, 4)
        )
        combo_jan = ttk.Combobox(
            controles_curva,
            textvariable=self.var_janela_s,
            values=["20", "30", "60", "120", "300"],
            width=5,
            state="readonly",
        )
        combo_jan.pack(side=tk.LEFT, padx=(0, 10))
        combo_jan.bind("<<ComboboxSelected>>", lambda _e: self._redesenhar_grafico())

        for texto, var, cor in [
            ("Real (PV)", self.var_show_real, COLOR_REAL),
            ("Calculado", self.var_show_calc, COLOR_CALC),
            ("SP",        self.var_show_sp,   COLOR_SP),
            ("PWM %",     self.var_show_pwm,  COLOR_PWM),
        ]:
            cb = tk.Checkbutton(
                controles_curva,
                text=texto,
                variable=var,
                command=self._redesenhar_grafico,
                bg=BG_PANEL,
                fg=cor,
                selectcolor=BG_INPUT,
                activebackground=BG_PANEL,
                activeforeground=cor,
                font=("Segoe UI", 9, "bold"),
                cursor="hand2",
            )
            cb.pack(side=tk.LEFT, padx=4)

        self.fig = Figure(figsize=(8.2, 4.6), dpi=100, facecolor=BG_PANEL)
        self.ax = self.fig.add_subplot(111)
        self.ax_pwm = self.ax.twinx()

        self.ax.set_facecolor("#0D1117")
        self.ax.grid(True, color="#243042", linestyle="--", linewidth=0.7, alpha=0.8)
        self.ax.set_xlabel("Tempo (s)", color=FG_MUTED, fontsize=9)
        self.ax.set_ylabel("Rotacao (RPM)", color=FG_TEXT, fontsize=9)
        self.ax.tick_params(colors=FG_MUTED, labelsize=8)

        self.ax_pwm.set_ylabel("PWM (%)", color=COLOR_PWM, fontsize=9)
        self.ax_pwm.tick_params(axis="y", colors=COLOR_PWM, labelsize=8)
        self.ax_pwm.set_ylim(-5, 105)

        for spine in self.ax.spines.values():
            spine.set_color("#334155")
        for spine in self.ax_pwm.spines.values():
            spine.set_color("#334155")

        (self.line_real,) = self.ax.plot([], [], color=COLOR_REAL, linewidth=2.2, label="Real - Sensor Hall (PV)")
        (self.line_calc,) = self.ax.plot([], [], color=COLOR_CALC, linewidth=2.0, label="Calculado - Modelo Teorico")
        (self.line_sp,)   = self.ax.plot([], [], color=COLOR_SP,   linewidth=1.6, linestyle="--", label="Referencia (SP)")
        (self.line_pwm,)  = self.ax_pwm.plot([], [], color=COLOR_PWM, linewidth=1.3, linestyle=":", alpha=0.85, label="PWM (%)")

        linhas = [self.line_real, self.line_calc, self.line_sp, self.line_pwm]
        labels = [l.get_label() for l in linhas]
        self.ax.legend(
            linhas, labels, loc="upper left", facecolor=BG_CARD, edgecolor="#334155",
            labelcolor=FG_TEXT, fontsize=8.5, framealpha=0.9
        )
        self.fig.tight_layout()

        self.canvas = FigureCanvasTkAgg(self.fig, master=frame_graf)
        self.canvas.get_tk_widget().grid(row=1, column=0, sticky="nsew")

