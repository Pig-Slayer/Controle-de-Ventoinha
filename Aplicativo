    def _construir_painel_controles(self, parent):
        tk.Label(
            parent, text="Entradas Principais (digite apenas o numero)",
            bg=BG_PANEL, fg=FG_TEXT, font=("Segoe UI", 10, "bold")
        ).pack(anchor="w", pady=(0, 6))

        self.entradas = {}

        # 5 campos principais na ordem do rascunho: KP, KI, KD, SP, PWM
        campos_principais = [
            ("KP",  "KP =",  "0.0193", "Ganho proporcional"),
            ("KI",  "KI =",  "0.0097", "Ganho integral"),
            ("KD",  "KD =",  "0.0",    "Ganho derivativo"),
            ("SP",  "SP =",  "4000",   "RPM max (ativa AUTO_RPM)"),
            ("PWM", "PWM =", "50",     "PWM fixo % (ativa MANUAL)"),
        ]

        for cmd, rotulo, padrao, dica in campos_principais:
            self._criar_linha_entrada(parent, cmd, rotulo, padrao, dica, destaque=True)

        ttk.Separator(parent, orient="horizontal").pack(fill=tk.X, pady=8)

        # Limites de PWM (PID e AUTO_PWM)
        tk.Label(
            parent, text="Limites de PWM (%) - PID e AUTO_PWM",
            bg=BG_PANEL, fg=COLOR_PWM, font=("Segoe UI", 9, "bold")
        ).pack(anchor="w", pady=(0, 4))

        frame_pwm_lim = tk.Frame(parent, bg=BG_CARD, padx=8, pady=6, highlightbackground="#334155", highlightthickness=1)
        frame_pwm_lim.pack(fill=tk.X, pady=(0, 6))

        tk.Label(frame_pwm_lim, text="MIN:", bg=BG_CARD, fg=FG_TEXT, font=("Consolas", 10, "bold")).pack(side=tk.LEFT)
        ent_pmin = tk.Entry(
            frame_pwm_lim, width=6, bg=BG_INPUT, fg=FG_TEXT, insertbackground=FG_TEXT,
            relief=tk.FLAT, font=("Consolas", 10)
        )
        ent_pmin.insert(0, "30")
        ent_pmin.pack(side=tk.LEFT, padx=(4, 10), ipady=3)
        ent_pmin.bind("<Return>", lambda _e: self._enviar_limites_pwm())
        self.entradas["PWMMIN"] = ent_pmin

        tk.Label(frame_pwm_lim, text="MAX:", bg=BG_CARD, fg=FG_TEXT, font=("Consolas", 10, "bold")).pack(side=tk.LEFT)
        ent_pmax = tk.Entry(
            frame_pwm_lim, width=6, bg=BG_INPUT, fg=FG_TEXT, insertbackground=FG_TEXT,
            relief=tk.FLAT, font=("Consolas", 10)
        )
        ent_pmax.insert(0, "100")
        ent_pmax.pack(side=tk.LEFT, padx=(4, 8), ipady=3)
        ent_pmax.bind("<Return>", lambda _e: self._enviar_limites_pwm())
        self.entradas["PWMMAX"] = ent_pmax

        self._criar_botao(
            frame_pwm_lim, "Aplicar PWM", self._enviar_limites_pwm, bg="#B45309"
        ).pack(side=tk.RIGHT)

        # Parametros adicionais do ciclo da ESP32
        tk.Label(
            parent, text="Ciclo Automatico & Sensor",
            bg=BG_PANEL, fg=FG_TEXT, font=("Segoe UI", 9, "bold")
        ).pack(anchor="w", pady=(2, 4))

        campos_extras = [
            ("MIN",   "MIN =",   "1000", "RPM minimo (ciclo AUTO_RPM)"),
            ("TEMPO", "TEMPO =", "5",    "Segundos por etapa (>= 1)"),
            ("PPR",   "PPR =",   "2",    "Pulsos/volta do Hall"),
        ]
        for cmd, rotulo, padrao, dica in campos_extras:
            self._criar_linha_entrada(parent, cmd, rotulo, padrao, dica, destaque=False)

        ttk.Separator(parent, orient="horizontal").pack(fill=tk.X, pady=8)

        # Parametros do Modelo Calculado (1a ordem)
        tk.Label(
            parent, text="Curva Calculada: G(s) = K / (tau*s + 1)",
            bg=BG_PANEL, fg=COLOR_CALC, font=("Segoe UI", 9, "bold")
        ).pack(anchor="w", pady=(0, 4))

        frame_mod = tk.Frame(parent, bg=BG_PANEL)
        frame_mod.pack(fill=tk.X, pady=(0, 6))

        tk.Label(frame_mod, text="K (RPM/%):", bg=BG_PANEL, fg=FG_MUTED, font=("Segoe UI", 9)).pack(side=tk.LEFT)
        self.ent_k = tk.Entry(
            frame_mod, width=7, bg=BG_INPUT, fg=FG_TEXT, insertbackground=FG_TEXT,
            relief=tk.FLAT, font=("Consolas", 10)
        )
        self.ent_k.insert(0, str(self.modelo_k))
        self.ent_k.pack(side=tk.LEFT, padx=(4, 10), ipady=3)
        self.ent_k.bind("<Return>", lambda _e: self._aplicar_modelo())

        tk.Label(frame_mod, text="tau (s):", bg=BG_PANEL, fg=FG_MUTED, font=("Segoe UI", 9)).pack(side=tk.LEFT)
        self.ent_tau = tk.Entry(
            frame_mod, width=7, bg=BG_INPUT, fg=FG_TEXT, insertbackground=FG_TEXT,
            relief=tk.FLAT, font=("Consolas", 10)
        )
        self.ent_tau.insert(0, str(self.modelo_tau))
        self.ent_tau.pack(side=tk.LEFT, padx=(4, 8), ipady=3)
        self.ent_tau.bind("<Return>", lambda _e: self._aplicar_modelo())

        self._criar_botao(frame_mod, "Aplicar", self._aplicar_modelo, bg="#0F766E").pack(side=tk.RIGHT)

        # Mini console de retorno da ESP32
        tk.Label(
            parent, text="Respostas da ESP32",
            bg=BG_PANEL, fg=FG_MUTED, font=("Segoe UI", 9, "bold")
        ).pack(anchor="w", pady=(2, 3))

        self.txt_log = tk.Text(
            parent,
            height=5,
            bg=BG_INPUT,
            fg="#CBD5E1",
            font=("Consolas", 9),
            relief=tk.FLAT,
            state=tk.DISABLED,
            wrap=tk.WORD,
        )
        self.txt_log.pack(fill=tk.BOTH, expand=True)

    def _criar_linha_entrada(self, parent, cmd: str, rotulo: str, padrao: str, dica: str, destaque: bool):
        box = tk.Frame(
            parent,
            bg=BG_CARD if destaque else BG_PANEL,
