    def _criar_botao(self, parent, texto, comando, bg=BG_CARD, width=None, pady=3):
        return tk.Button(
            parent,
            text=texto,
            command=comando,
            bg=bg,
            fg=FG_TEXT,
            activebackground="#475569",
            activeforeground="#FFFFFF",
            relief=tk.FLAT,
            font=("Segoe UI", 9, "bold"),
            padx=10,
            pady=pady,
            width=width,
            cursor="hand2",
        )

    # -------------------------------------------------------------------------
    # SERIAL: CONEXAO, LEITURA E ENVIO
    # -------------------------------------------------------------------------
    def _atualizar_portas(self):
        portas = list(serial.tools.list_ports.comports())
        itens = [f"{p.device} - {p.description}" for p in portas]
        self.combo_porta["values"] = itens
        if itens:
            self.combo_porta.current(0)
        else:
            self.combo_porta.set("Nenhuma porta encontrada")

    def _alternar_conexao(self):
        if self.ser and self.ser.is_open:
            self._desconectar()
        else:
            self._conectar()

    def _conectar(self):
        selecao = self.combo_porta.get()
        if not selecao or selecao.startswith("Nenhuma"):
            messagebox.showwarning("Porta Serial", "Selecione uma porta COM valida.")
            return

        porta = selecao.split(" - ")[0].strip()
        try:
            ser = serial.Serial()
            ser.port = porta
            ser.baudrate = 115200
            ser.timeout = 0.2
            ser.dtr = False
            ser.rts = False
            ser.open()
            self.ser = ser
        except serial.SerialException as exc:
            messagebox.showerror("Erro ao Conectar", f"Nao foi possivel abrir {porta}:\n{exc}")
            return

        self.stop_event.clear()
        self.reader_thread = threading.Thread(target=self._loop_leitura_serial, daemon=True)
        self.reader_thread.start()

        self.btn_conectar.configure(text="Desconectar", bg=COLOR_ERR)
        self.lbl_conexao.configure(text=f"● CONECTADO ({porta})", fg=COLOR_OK)
        self._log(f"Conectado em {porta} @ 115200 baud.")

        self.root.after(400, lambda: self._enviar_comando("STATUS", silencioso=True))

    def _desconectar(self):
        self.stop_event.set()
        if self.reader_thread and self.reader_thread.is_alive():
            self.reader_thread.join(timeout=0.5)

        with self.serial_lock:
            if self.ser:
                try:
                    self.ser.close()
                except Exception:
                    pass
                self.ser = None

        self.estado["modo"] = "DESCONECTADO"
        self.btn_conectar.configure(text="Conectar", bg=ACCENT)
        self.lbl_conexao.configure(text="● DESCONECTADO", fg=COLOR_ERR)
        self._atualizar_cards_status()
        self._log("Conexao encerrada.")

    def _loop_leitura_serial(self):
        while not self.stop_event.is_set():
            try:
                if not self.ser or not self.ser.is_open:
                    break
                bruto = self.ser.readline()
                if not bruto:
                    continue
                linha = bruto.decode("utf-8", errors="ignore").strip()
                if linha:
                    self.msg_queue.put(("linha", linha, time.monotonic()))
            except serial.SerialException as exc:
                self.msg_queue.put(("erro_serial", str(exc), time.monotonic()))
                break
            except Exception:
                continue

    def _enviar_comando(self, comando: str, silencioso: bool = False):
        if not self.ser or not self.ser.is_open:
            if not silencioso:
                messagebox.showwarning("Desconectado", "Conecte na porta serial da ESP32 primeiro.")
            return
        try:
            with self.serial_lock:
                self.ser.write((comando + "\n").encode("utf-8"))
            if not silencioso:
                self._log(f">>> {comando}")
        except serial.SerialException as exc:
            self._log(f"Erro ao enviar '{comando}': {exc}")

    def _enviar_parametro(self, cmd: str):
        texto = self.entradas[cmd].get().strip().replace(",", ".")
        try:
            valor = float(texto)
            if not math.isfinite(valor):
                raise ValueError
        except ValueError:
            messagebox.showerror("Valor Invalido", f"Digite apenas um numero valido para {cmd}.")
            return

        self._enviar_comando(f"{cmd}={valor:g}")

    def _enviar_limites_pwm(self):
        try:
            v_min = float(self.entradas["PWMMIN"].get().strip().replace(",", "."))
            v_max = float(self.entradas["PWMMAX"].get().strip().replace(",", "."))
            if not (math.isfinite(v_min) and math.isfinite(v_max)):
                raise ValueError
        except ValueError:
            messagebox.showerror("PWM Invalido", "Digite apenas numeros validos para PWM MIN e MAX.")
            return

        if v_min < 0.0 or v_max > 100.0 or v_min > v_max:
            messagebox.showerror("Faixa Invalida", "Use valores entre 0 e 100, com MIN <= MAX.")
            return

        # Define a ordem segura para nunca cruzar os limites atuais na ESP32
        if v_min > self.estado["pwm_max"]:
            self._enviar_comando(f"PWMMAX={v_max:g}")
            self.root.after(60, lambda: self._enviar_comando(f"PWMMIN={v_min:g}"))
        else:
            self._enviar_comando(f"PWMMIN={v_min:g}")
            self.root.after(60, lambda: self._enviar_comando(f"PWMMAX={v_max:g}"))

    def _alternar_modo_auto(self):
        if self.estado["modo"] == "AUTO_RPM":
            self._enviar_comando("MANUAL")
        else:
            self._enviar_comando("AUTO")

    def _aplicar_modelo(self):
        try:
            k_val = float(self.ent_k.get().strip().replace(",", "."))
            tau_val = float(self.ent_tau.get().strip().replace(",", "."))
            if not (math.isfinite(k_val) and math.isfinite(tau_val)) or tau_val < 0.0:
                raise ValueError
        except ValueError:
            messagebox.showerror("Modelo Invalido", "Informe numeros validos (tau >= 0).")
            return

        self.modelo_k = k_val
        self.modelo_tau = tau_val
        self._log(f"Modelo teorico atualizado: K={self.modelo_k:g} RPM/%, tau={self.modelo_tau:g} s.")

    # -------------------------------------------------------------------------
    # PROCESSAMENTO DE DADOS, SIMULACAO DO MODELO E ATUALIZACAO DA TELA
    # -------------------------------------------------------------------------
    def _processar_fila(self):
        houve_telemetria = False

        try:
            while True:
                tipo, conteudo, ts = self.msg_queue.get_nowait()
                if tipo == "erro_serial":
                    self._log(f"Conexao perdida: {conteudo}")
                    self._desconectar()
                    break

                if tipo == "linha":
                    if self._tratar_telemetria(conteudo, ts):
                        houve_telemetria = True
                    else:
                        self._tratar_mensagem_texto(conteudo)
        except queue.Empty:
            pass

        if houve_telemetria:
            self._atualizar_cards_status()
            self._redesenhar_grafico()

        self.root.after(50, self._processar_fila)

    def _tratar_telemetria(self, linha: str, ts: float) -> bool:
        m = TELEMETRIA_RE.search(linha)
        if not m:
            return False

        modo = m.group(1)
        sp   = float(m.group(2))
        pv   = float(m.group(3))
        pwm  = float(m.group(4))
        hz   = float(m.group(5))

        if self.t_inicio is None:
            self.t_inicio = ts
            self.t_ultimo = ts
            self.y_calc = pv

        dt = max(0.001, min(ts - self.t_ultimo, 1.0))
        self.t_ultimo = ts
        t_rel = ts - self.t_inicio

        # Discretizacao exata (ZOH) do modelo de 1a ordem: G(s) = K / (tau*s + 1)
        alvo_modelo = self.modelo_k * pwm
        if self.modelo_tau > 0.0:
            alfa = math.exp(-dt / self.modelo_tau)
            self.y_calc = alfa * self.y_calc + (1.0 - alfa) * alvo_modelo
        else:
            self.y_calc = alvo_modelo

        self.estado["modo"] = modo
        self.estado["sp"]   = sp
        self.estado["pv"]   = pv
        self.estado["calc"] = self.y_calc
        self.estado["pwm"]  = pwm
        self.estado["hz"]   = hz

        self.t_hist.append(t_rel)
        self.sp_hist.append(sp)
        self.pv_hist.append(pv)
        self.calc_hist.append(self.y_calc)
        self.pwm_hist.append(pwm)

        self.sessao_csv.append((
            round(t_rel, 3), modo, sp, pv, round(self.y_calc, 2), pwm, hz,
            self.estado["pwm_min"], self.estado["pwm_max"],
            self.estado["kp"], self.estado["ki"], self.estado["kd"]
        ))
        return True

    def _tratar_mensagem_texto(self, linha: str):
        atualizou_estado = False

        for chave, padrao in STATUS_PATTERNS.items():
            m = padrao.search(linha)
            if m:
                val = float(m.group(1))
                destino = chave.replace("_ack", "")
                if destino == "min":
                    destino = "sp_min"
                self.estado[destino] = val
                atualizou_estado = True

        m_rpm = AUTO_RPM_ACK_RE.search(linha)
        if m_rpm:
            self.estado["sp_max"] = float(m_rpm.group(1))
            self.estado["sp_min"] = float(m_rpm.group(2))
            atualizou_estado = True

        m_pwm = AUTO_PWM_ACK_RE.search(linha)
        if m_pwm:
            self.estado["pwm_min"] = float(m_pwm.group(1))
            self.estado["pwm_max"] = float(m_pwm.group(2))
            atualizou_estado = True

        if atualizou_estado:
            self._atualizar_cards_status()

        self._log(linha)

    def _atualizar_cards_status(self):
        e = self.estado
        erro = e["sp"] - e["pv"]

        self.cards["modo"].configure(text=e["modo"])
        self.cards["pv"].configure(text=f"{e['pv']:.1f} RPM")
        self.cards["calc"].configure(text=f"{e['calc']:.1f} RPM")
        self.cards["sp"].configure(text=f"{e['sp']:.1f} RPM")
        self.cards["erro"].configure(text=f"{erro:+.1f} RPM")
        self.cards["pwm"].configure(text=f"{e['pwm']:.1f} %")
        self.cards["pwm_lim"].configure(text=f"{e['pwm_min']:.0f} / {e['pwm_max']:.0f}%")
        self.cards["hz"].configure(text=f"{e['hz']:.1f} Hz")
        self.cards["kp"].configure(text=f"{e['kp']:.5g}")
        self.cards["ki"].configure(text=f"{e['ki']:.5g}")
        self.cards["kd"].configure(text=f"{e['kd']:.5g}")
        self.cards["lim"].configure(text=f"{e['sp_min']:.0f}/{e['sp_max']:.0f}")
        self.cards["extra"].configure(text=f"{e['tempo']:.1f}s | {e['ppr']:.1g}")

        if e["modo"] == "AUTO_RPM":
            self.btn_modo_auto.configure(
                text="Modo Auto (PID): ON", bg="#15803D", activebackground="#166534"
            )
            self.cards["modo"].configure(fg=COLOR_OK)
        elif e["modo"] == "AUTO_PWM":
            self.btn_modo_auto.configure(
                text="Modo Auto (PID): OFF", bg="#B45309", activebackground="#92400E"
            )
            self.cards["modo"].configure(fg=COLOR_WARN)
        elif e["modo"] == "MANUAL":
            self.btn_modo_auto.configure(
                text="Modo Auto (PID): OFF", bg="#7F1D1D", activebackground="#991B1B"
            )
            self.cards["modo"].configure(fg=ACCENT)
        else:
            self.btn_modo_auto.configure(
                text="Modo Auto (PID): OFF", bg="#475569", activebackground="#334155"
            )
            self.cards["modo"].configure(fg=COLOR_ERR)

    def _redesenhar_grafico(self):
        if not self.t_hist:
            self.line_real.set_data([], [])
            self.line_calc.set_data([], [])
            self.line_sp.set_data([], [])
            self.line_pwm.set_data([], [])
            self.canvas.draw_idle()
            return

        t_list = list(self.t_hist)
        janela = float(self.var_janela_s.get())
        t_atual = t_list[-1]
        t_min = max(0.0, t_atual - janela)

        self.line_real.set_visible(self.var_show_real.get())
        self.line_calc.set_visible(self.var_show_calc.get())
        self.line_sp.set_visible(self.var_show_sp.get())
        self.line_pwm.set_visible(self.var_show_pwm.get())

        self.line_real.set_data(t_list, list(self.pv_hist))
        self.line_calc.set_data(t_list, list(self.calc_hist))
        self.line_sp.set_data(t_list, list(self.sp_hist))
        self.line_pwm.set_data(t_list, list(self.pwm_hist))

        self.ax.set_xlim(t_min, max(janela, t_atual))

        y_vals = []
        for idx, t in enumerate(t_list):
            if t < t_min:
                continue
            if self.var_show_real.get():
                y_vals.append(self.pv_hist[idx])
            if self.var_show_calc.get():
                y_vals.append(self.calc_hist[idx])
            if self.var_show_sp.get():
                y_vals.append(self.sp_hist[idx])

        if y_vals:
            y_max = max(y_vals)
            y_min = min(y_vals)
            topo = max(1200.0, y_max * 1.12)
            base = min(0.0, y_min - 100.0)
            self.ax.set_ylim(base, topo)

        self.canvas.draw_idle()

    # -------------------------------------------------------------------------
    # UTILIDADES (LIMPAR, CSV, LOG, FECHAR)
    # -------------------------------------------------------------------------
    def _limpar_dados(self):
        self.t_inicio = None
        self.t_ultimo = None
        self.t_hist.clear()
        self.sp_hist.clear()
        self.pv_hist.clear()
        self.calc_hist.clear()
        self.pwm_hist.clear()
        self.sessao_csv.clear()
        self._redesenhar_grafico()
        self._log("Grafico e buffer limpos.")

    def _exportar_csv(self):
        if not self.sessao_csv:
            messagebox.showinfo("Exportar CSV", "Ainda nao ha dados coletados para exportar.")
            return

        nome_padrao = f"ventoinha_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv"
        caminho = filedialog.asksaveasfilename(
            defaultextension=".csv",
            initialfile=nome_padrao,
            filetypes=[("Arquivo CSV", "*.csv")],
        )
        if not caminho:
            return

        try:
            with open(caminho, "w", newline="", encoding="utf-8") as arq:
                writer = csv.writer(arq, delimiter=";")
                writer.writerow([
                    "Tempo_s", "Modo", "SP_RPM", "PV_Real_RPM",
                    "Calculado_RPM", "PWM_Pct", "Freq_Hz",
                    "PWM_Min_Pct", "PWM_Max_Pct", "Kp", "Ki", "Kd"
                ])
                writer.writerows(self.sessao_csv)
            self._log(f"Dados salvos em: {caminho}")
        except OSError as exc:
            messagebox.showerror("Erro ao Salvar", f"Nao foi possivel salvar o CSV:\n{exc}")

    def _log(self, texto: str):
        self.txt_log.configure(state=tk.NORMAL)
        hora = datetime.now().strftime("%H:%M:%S")
        self.txt_log.insert(tk.END, f"[{hora}] {texto}\n")
        self.txt_log.see(tk.END)
        self.txt_log.configure(state=tk.DISABLED)

    def _ao_fechar(self):
        self._desconectar()
        self.root.destroy()


