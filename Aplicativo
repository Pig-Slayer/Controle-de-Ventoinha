# =============================================================================
# EXPRESSOES REGULARES PARA INTERPRETAR A SERIAL DA ESP32
# =============================================================================
TELEMETRIA_RE = re.compile(
    r"Modo:(\S+)\s+SP:([-+]?\d+(?:\.\d+)?)\s+PV:([-+]?\d+(?:\.\d+)?)\s+"
    r"PWM:([-+]?\d+(?:\.\d+)?)\s+Hz:([-+]?\d+(?:\.\d+)?)"
)

STATUS_PATTERNS = {
    "pwm_min":     re.compile(r"^PWM Minimo:\s*([-+]?\d+(?:\.\d+)?)"),
    "pwm_max":     re.compile(r"^PWM Maximo:\s*([-+]?\d+(?:\.\d+)?)"),
    "sp_max":      re.compile(r"^SP Maximo:\s*([-+]?\d+(?:\.\d+)?)"),
    "sp_min":      re.compile(r"^SP Minimo:\s*([-+]?\d+(?:\.\d+)?)"),
    "tempo":       re.compile(r"^Tempo Ciclo:\s*([-+]?\d+(?:\.\d+)?)"),
    "kp":          re.compile(r"^Kp:\s*([-+]?\d+(?:\.\d+)?)"),
    "ki":          re.compile(r"^Ki:\s*([-+]?\d+(?:\.\d+)?)"),
    "kd":          re.compile(r"^Kd:\s*([-+]?\d+(?:\.\d+)?)"),
    "ppr":         re.compile(r"^PPR:\s*([-+]?\d+(?:\.\d+)?)"),
    "pwm_min_ack": re.compile(r"^Novo PWM Minimo:\s*([-+]?\d+(?:\.\d+)?)"),
    "pwm_max_ack": re.compile(r"^Novo PWM Maximo:\s*([-+]?\d+(?:\.\d+)?)"),
    "kp_ack":      re.compile(r"^Novo Kp:\s*([-+]?\d+(?:\.\d+)?)"),
    "ki_ack":      re.compile(r"^Novo Ki:\s*([-+]?\d+(?:\.\d+)?)"),
    "kd_ack":      re.compile(r"^Novo Kd:\s*([-+]?\d+(?:\.\d+)?)"),
    "ppr_ack":     re.compile(r"^Novo PPR:\s*([-+]?\d+(?:\.\d+)?)"),
    "min_ack":     re.compile(r"^Novo SP Minimo:\s*([-+]?\d+(?:\.\d+)?)"),
    "tempo_ack":   re.compile(r"^Tempo de cada etapa:\s*([-+]?\d+(?:\.\d+)?)"),
}

AUTO_RPM_ACK_RE = re.compile(
    r"Alternando entre\s+([-+]?\d+(?:\.\d+)?)\s+RPM e\s+([-+]?\d+(?:\.\d+)?)\s+RPM"
)
AUTO_PWM_ACK_RE = re.compile(
    r"Alternando entre\s+([-+]?\d+(?:\.\d+)?)%\s+e\s+([-+]?\d+(?:\.\d+)?)%"
)


# =============================================================================
# PALETA DE CORES (TEMA ESCURO)
# =============================================================================
BG_MAIN    = "#12161F"
BG_PANEL   = "#1B2230"
BG_CARD    = "#232C3D"
BG_INPUT   = "#0F131B"
FG_TEXT    = "#EAEFF7"
FG_MUTED   = "#94A3B8"
ACCENT     = "#3A86FF"
COLOR_REAL = "#FF595E"   # PV (Sensor Hall)
