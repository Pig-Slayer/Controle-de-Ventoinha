            highlightbackground="#334155" if destaque else BG_PANEL,
            highlightthickness=1 if destaque else 0,
        )
        box.pack(fill=tk.X, pady=2 if destaque else 1)

        lbl = tk.Label(
            box,
            text=rotulo,
            width=8,
            anchor="w",
            bg=BG_CARD if destaque else BG_PANEL,
            fg=FG_TEXT,
            font=("Consolas", 11 if destaque else 9, "bold"),
        )
        lbl.pack(side=tk.LEFT)

        ent = tk.Entry(
            box,
            width=11,
            bg=BG_INPUT,
            fg=FG_TEXT,
            insertbackground=FG_TEXT,
